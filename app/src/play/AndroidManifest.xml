<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Google Play distribution deliberately excludes permissions whose policy surface
        is not required for PersonalHub's core store-distributed experience. The normal
        private release build remains unchanged.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_CALL_LOG"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <application>
        <receiver
            android:name="com.supercontacts.app.CallStateReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.supercontacts.app.CallOverlayDebugReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.gernalix.luoghi.capsules.geofence.PlaceGeofenceReceiver"
            tools:node="remove" />
    </application>
</manifest>
