{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gernalix/codex-roadmap/blob/main/docs/project-capsule/schema-v1.json",
  "title": "C2 Project Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "scope", "repository", "architecture", "dependencies", "data", "runtime", "devices", "commands", "safety", "acceptance", "references", "freshness", "artifacts", "validation_hooks", "change_verification"],
  "properties": {
    "schema_version": {"const": "c2.project-capsule.v1"},
    "identity": {"type": "object", "required": ["project_id", "slug", "repository_id"], "properties": {"project_id": {"type": "integer", "minimum": 1}, "slug": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "scope": {"$ref": "#/$defs/boundedText"},
    "repository": {"type": "object", "required": ["canonical_workdir", "branch_policy"], "properties": {"canonical_workdir": {"type": "string", "minLength": 1}, "branch_policy": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "architecture": {"type": "object", "required": ["summary", "entrypoints", "important_paths"], "properties": {"summary": {"type": "string", "minLength": 1}, "entrypoints": {"$ref": "#/$defs/paths"}, "important_paths": {"$ref": "#/$defs/paths"}}, "additionalProperties": false},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "purpose"], "properties": {"name": {"type": "string"}, "project_id": {"type": "integer"}, "purpose": {"type": "string"}}, "additionalProperties": false}},
    "data": {"type": "object", "required": ["schema", "migrations"], "properties": {"schema": {"type": "string"}, "migrations": {"type": "string"}}, "additionalProperties": false},
    "runtime": {"type": "object", "required": ["services", "timers", "containers"], "properties": {"services": {"$ref": "#/$defs/strings"}, "timers": {"$ref": "#/$defs/strings"}, "containers": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "devices": {"$ref": "#/$defs/strings"},
    "commands": {"type": "object", "required": ["setup", "build", "test_targeted", "test_full", "lint", "deploy_install", "smoke", "verify"], "properties": {"setup": {"$ref": "#/$defs/commandOrNA"}, "build": {"$ref": "#/$defs/commandOrNA"}, "test_targeted": {"$ref": "#/$defs/commandOrNA"}, "test_full": {"$ref": "#/$defs/commandOrNA"}, "lint": {"$ref": "#/$defs/commandOrNA"}, "deploy_install": {"$ref": "#/$defs/commandOrNA"}, "smoke": {"$ref": "#/$defs/commandOrNA"}, "verify": {"type": "object", "required": ["fast", "full"], "properties": {"fast": {"$ref": "#/$defs/command"}, "full": {"$ref": "#/$defs/command"}}, "additionalProperties": false}}, "additionalProperties": false},
    "safety": {"type": "object", "required": ["invariants", "risky_operations", "recovery"], "properties": {"invariants": {"$ref": "#/$defs/strings"}, "risky_operations": {"$ref": "#/$defs/strings"}, "recovery": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "acceptance": {"$ref": "#/$defs/strings"},
    "references": {"type": "object", "required": ["megavault", "c2"], "properties": {"megavault": {"type": "string", "minLength": 1}, "c2": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "freshness": {"type": "object", "required": ["reviewed_commit", "watch_paths"], "properties": {"reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "watch_paths": {"$ref": "#/$defs/paths"}}, "additionalProperties": false},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "validation_hooks": {"type": "array", "items": {"type": "object", "required": ["id", "argv", "cwd", "safe"], "properties": {"id": {"type": "string", "minLength": 1}, "argv": {"$ref": "#/$defs/argv"}, "cwd": {"type": "string"}, "safe": {"type": "boolean"}}, "additionalProperties": false}},
    "change_verification": {"type": "array", "items": {"type": "object", "required": ["paths", "commands"], "properties": {"paths": {"$ref": "#/$defs/paths"}, "commands": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "object", "required": ["argv", "cwd"], "properties": {"argv": {"$ref": "#/$defs/argv"}, "cwd": {"type": "string"}}, "additionalProperties": false},
    "commandOrNA": {"oneOf": [{"$ref": "#/$defs/command"}, {"type": "object", "required": ["not_applicable"], "properties": {"not_applicable": {"type": "string", "minLength": 1}}, "additionalProperties": false}]},
    "boundedText": {"type": "object", "required": ["purpose", "boundaries"], "properties": {"purpose": {"type": "string", "minLength": 1}, "boundaries": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}
  }
}
