<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".SaluteActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name="com.gernalix.personalhub.shortcut.SaluteShortcutActivity"
            android:exported="true"
            android:targetActivity=".SaluteActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:host="module" android:path="/salute" android:scheme="personalhub" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
