<?xml version="1.0" encoding="utf-8"?>
<!--
  System Auto Backup is intentionally disabled for this app.
  User data restore is handled explicitly by MultiTimeTracker via the user-chosen data folder.
  These rules stay deny-all to document the contract and prevent future accidental inclusion.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
